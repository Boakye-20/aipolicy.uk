# Copy this file to `.env` in the ingestion/ folder and fill in your real key.
# .env is gitignored — never commit your real key.
# NOTE: never put a real key in this .example file — it is a shared template.
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY

# The Postgres connection string (Neon direct connection, port 5432-style host
# without "-pooler"). The ETL is a batch job, so it uses the direct connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
